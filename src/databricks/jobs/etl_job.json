{
  "name": "Banking_Lakehouse_ETL_Job",
  "email_notifications": {
    "on_failure": ["alerts-dataops@bank.example.test"],
    "no_alert_for_skipped_runs": true
  },
  "timeout_seconds": 7200,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "bronze_to_silver_transformations",
      "description": "Cleanse and merge raw landing data into Silver Delta tables",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/1_bronze_to_silver.py",
        "parameters": [
          "abfss://bronze@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2,
        "spark_conf": {
          "spark.sql.extensions": "io.delta.sql.DeltaSparkSessionExtension",
          "spark.sql.catalog.spark_catalog": "org.apache.spark.sql.delta.catalog.DeltaCatalog"
        }
      }
    },
    {
      "task_key": "silver_to_gold_aggregations",
      "depends_on": [
        {
          "task_key": "bronze_to_silver_transformations"
        }
      ],
      "description": "Aggregate daily account metrics and executive KPIs into Gold Delta tables",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/2_silver_to_gold.py",
        "parameters": [
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://gold@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 3 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  }
}
