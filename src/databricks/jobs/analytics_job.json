{
  "name": "Banking_Lakehouse_Risk_Analytics_Job",
  "email_notifications": {
    "on_failure": ["alerts-riskops@bank.example.test"]
  },
  "timeout_seconds": 10800,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "fraud_detection_scoring",
      "description": "Run velocity and statistical anomaly detection for Fraud Risk",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/3_fraud_detection.py",
        "parameters": [
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://gold@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2
      }
    },
    {
      "task_key": "credit_risk_assessment",
      "description": "Compute credit risk rating and expected losses",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/4_credit_risk.py",
        "parameters": [
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://gold@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2
      }
    },
    {
      "task_key": "aml_monitoring_rules",
      "description": "Detect structuring and suspicious cash movement",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/5_aml_monitoring.py",
        "parameters": [
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://gold@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2
      }
    },
    {
      "task_key": "customer_360_consolidation",
      "depends_on": [
        { "task_key": "fraud_detection_scoring" },
        { "task_key": "credit_risk_assessment" },
        { "task_key": "aml_monitoring_rules" }
      ],
      "description": "Consolidate complete Customer 360 golden profile",
      "spark_python_task": {
        "python_file": "src/databricks/notebooks/6_customer_360.py",
        "parameters": [
          "abfss://silver@adlsbankingplatformdev.dfs.core.windows.net",
          "abfss://gold@adlsbankingplatformdev.dfs.core.windows.net"
        ]
      },
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_D4ds_v5",
        "num_workers": 2
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 4 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  }
}
