    subgraph "CONSUMERS"
        C1[Executives]
        C2[Risk Managers]
        C3[Compliance Officers]
        C4[Branch Managers]
        C5[Analysts]
    end

    DS1 & DS2 & DS3 --> SM1
    SM1 --> SM2
    SM2 --> SM3

    SM3 --> A1 & A2 & A3 & A4
    A1 & A2 & A3 & A4 --> V1 & V2 & V3 & V4 & V5 & V6

    V1 --> C1
    V2 --> C2
    V3 --> C2
    V4 --> C3
    V5 --> C4 & C5
    V6 --> C5