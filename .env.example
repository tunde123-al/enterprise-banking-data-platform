# ==============================================================================
# Enterprise Banking Data & Analytics Platform - Environment Configuration
# Synthetic Data / Local & Azure Configuration Template
# ==============================================================================

ENVIRONMENT=local

# Azure Core
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-banking-platform-dev
AZURE_LOCATION=eastus
KEY_VAULT_NAME=kv-banking-platform-dev

# Azure Data Lake Storage Gen2
ADLS_ACCOUNT_NAME=adlsbankingplatformdev
ADLS_CONTAINER_RAW=raw
ADLS_CONTAINER_BRONZE=bronze
ADLS_CONTAINER_SILVER=silver
ADLS_CONTAINER_GOLD=gold
ADLS_ACCESS_KEY=

# Azure Databricks
DATABRICKS_WORKSPACE_URL=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# Azure Synapse Analytics
SYNAPSE_WORKSPACE_NAME=syn-banking-platform-dev
SYNAPSE_SQL_POOL_NAME=sqlpoolbankingdev
SYNAPSE_SQL_USER=sqladminuser
SYNAPSE_SQL_PASSWORD=

# dbt profile (src/dbt/profiles.yml) - Synapse target
SYNAPSE_HOST=
SYNAPSE_PORT=1433
SYNAPSE_DATABASE=bankingwarehouse
SYNAPSE_SCHEMA=dbo
SYNAPSE_USER=
SYNAPSE_PASSWORD=

# dbt profile - Databricks target (optional)
DATABRICKS_CATALOG=banking
DATABRICKS_SCHEMA=gold
DATABRICKS_SERVER_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Local / Containerized Source Databases (Docker Compose)
# Copy this file to .env and replace every <...> placeholder with a value of
# your own. docker-compose.yml refuses to start until the three passwords are set.
# These are throwaway local-container credentials; never reuse a real password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=core_banking
POSTGRES_USER=bankadmin
POSTGRES_PASSWORD=<choose-a-local-dev-password>

ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=bankadmin
ORACLE_PASSWORD=<choose-a-local-dev-password>
ORACLE_DSN=localhost:1521/XEPDB1

SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DB=loan_management
SQLSERVER_USER=sa
# SQL Server requires 8+ characters with upper case, lower case and a digit.
SQLSERVER_PASSWORD=<choose-a-local-dev-password>
# Full ODBC connection string is required by src/data_generation/load_to_sqlserver.py
# (repeat the SQLSERVER_PASSWORD value after Pwd=).
SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=loan_management;Uid=sa;Pwd=<same-as-SQLSERVER_PASSWORD>;Encrypt=no;TrustServerCertificate=yes

# Azure SQL Database source (same loader as SQL Server)
AZURESQL_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=your-server.database.windows.net;Database=digital_banking;Uid=azureuser;Pwd=;Encrypt=yes

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=digital_banking

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=banking_events

# Apache Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=./src/ingestion/airflow_dags

# FastAPI Microservice
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
